# 白名单策略：默认全忽略，只放行确定安全的
*
!.gitignore

# === 核心资产目录 ===
!memories/
!memories/**
!skills/
!skills/**
!scripts/
!scripts/**
!reviews/
!reviews/**
!references/
!references/**
!profiles/
!profiles/**
!cron/
!cron/**

# === 知识文档 ===
!lessons.md
!safety_invariants.md
!model_routing.md
!config.yaml

# === 凭证类绝不入库（放在所有放行规则之后，优先级最高）===
.env
.env.*
**/.env
**/.env.*
**/auth.json
**/*.pem
**/*.key
**/hermes-cloud-connection.json
**/.local/
profiles/**/.env
profiles/**/auth.json
